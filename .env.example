# Copy to .env and export, or set these in the shell before starting.

# ollama | stub   (stub = local rules engine, no model)
LLM_PROVIDER=ollama
# If Ollama is down, fall back to the local rules engine and say so in the UI.
LLM_FALLBACK=stub

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Optional. Used only when a photo has no text layer and this model is installed.
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# 1 = serve recorded ClinicalTrials.gov results for the 3 prepared patients (offline demo)
DEMO_CACHE=1
# DEMO_CACHE_PATH=data/demo_cache.json
# TRIALRADAR_DATA=data

CHECK_TOP_N=5
# Miles retrieved on each search so the distance slider can move without a new request.
FETCH_RADIUS_MI=250

HOST=127.0.0.1
PORT=8000

# Nominatim requires a contact-style User-Agent. Hardcoded demo cities are tried first.
NOMINATIM_USER_AGENT=TrialRadar/0.1 (local hackathon demo)
